[Unit]
Description=NSE Trading Bot
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONPATH=__APP_DIR__
ExecStart=/bin/bash -lc 'source __APP_DIR__/.venv/bin/activate && cd __APP_DIR__ && python main.py'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
