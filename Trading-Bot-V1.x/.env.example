# Telegram settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI for scoring and notes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# News API for sentiment scoring
NEWS_API_KEY=

# Symbol universe
SYMBOLS_FILE=data/nifty200.csv

# Price range filters
MIN_STOCK_PRICE=10.0
MAX_STOCK_PRICE=1000.0

# Scan behavior
SCAN_INTERVAL_MINUTES=30
MONITOR_INTERVAL_MINUTES=30
HISTORY_PERIOD=60d
HISTORY_INTERVAL=30m
MINIMUM_BUY_SCORE=65.0
MINIMUM_VOLUME_RATIO=1.0
MAX_RECOMMENDATIONS=5
MIN_RECOMMENDATIONS=1

# Risk management
PORTFOLIO_SIZE=100000.0
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_VALUE_PCT=5.0
STOP_LOSS_PCT=3.0
TARGET_PCT=6.0
TRAILING_STOP_PCT=4.0
MAX_ACTIVE_POSITIONS=5
DEFAULT_QUANTITY=1

# Optional operational flags
PAPER_TRADING=true
ENABLE_AI=true
ENABLE_NEWS=true
PREVENT_SAME_DAY_BUY=true
COOLDOWN_DAYS=5
MAX_HOLDING_DAYS=30
